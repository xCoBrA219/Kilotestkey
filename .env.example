# Cloud Code Router - Environment-Variablen

# Router API-Schlüssel (optional, für Authentifizierung)
ROUTER_API_KEY=Ihr-Geheimer-API-Schlüssel

# Provider API-Schlüssel
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# Server-Konfiguration
SERVER_PORT=3000
SERVER_HOST=0.0.0.0

# Logging
LOG_LEVEL=info
LOG_FILE=logs/router.log
