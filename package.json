{
  "name": "cloud-code-router",
  "version": "1.0.0",
  "description": "Ein Open-Source API-Router für KI-Modelle - verbinden Sie mehrere Provider und routen Sie Anfragen intelligent",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.js",
    "docker:build": "docker build -t cloud-code-router .",
    "docker:run": "docker run -p 3000:3000 -v $(pwd)/config.json:/app/config.json cloud-code-router"
  },
  "keywords": [
    "ai",
    "api-router",
    "llm",
    "claude-code",
    "openai",
    "anthropic",
    "deepseek",
    "openrouter",
    "proxy",
    "gateway"
  ],
  "author": "xCoBrA219",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "fastify": "^4.24.0",
    "axios": "^1.6.2",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "rate-limiter-flexible": "^5.0.1",
    "uuid": "^9.0.0",
    "lodash": "^4.17.21",
    "joi": "^17.9.2",
    "js-yaml": "^4.1.0",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "compression": "^1.7.4",
    "http-proxy-middleware": "^2.0.6",
    "pino": "^8.17.2",
    "pino-http": "^8.6.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.7",
    "@types/lodash": "^4.14.202",
    "@types/js-yaml": "^4.0.9",
    "typescript": "^5.3.3",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
